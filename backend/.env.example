# Backend Nexo People — copie para backend/.env (nunca versione segredos reais).
DATABASE_URL=postgres://nexo:nexo@localhost:5432/nexo_people
PORT=3001
CORS_ORIGIN=http://localhost:4300
DEMO_MODE=true
# DEMO_MODE só é permitido com NODE_ENV=development ou test; o servidor demo usa loopback.
# NODE_ENV=production exige Microsoft Entra e/ou login por e-mail e senha.
# NODE_ENV=development

# Microsoft Entra SSO (use DEMO_MODE=false; valores públicos, sem client secret).
# MICROSOFT_ENTRA_TENANT_ID=00000000-0000-0000-0000-000000000000
# MICROSOFT_ENTRA_AUDIENCE=api://00000000-0000-0000-0000-000000000000
# MICROSOFT_ENTRA_SPA_CLIENT_ID=00000000-0000-0000-0000-000000000000
# MICROSOFT_ENTRA_REQUIRED_SCOPE=access_as_user

# Login por e-mail e senha (use DEMO_MODE=false). Só ativa usuários já cadastrados em `usuarios`.
# SMTP_PASSWORD é segredo: defina-o apenas no ambiente/cofre, nunca em arquivo versionado.
# AUTH_EMAIL_SENHA=true
# APP_URL=https://nexo.suaempresa.com.br        # origem do frontend usada nos links; HTTPS em produção
# SMTP_HOST=smtp.seu-provedor.com
# SMTP_PORT=587                                 # 587 = STARTTLS obrigatório; 465 = TLS implícito
# SMTP_USER=
# SMTP_PASSWORD=
# EMAIL_FROM="Nexo People <nao-responder@suaempresa.com.br>"
# TRUST_PROXY=1                                 # nº de proxies reversos confiáveis (para o IP real no limite de tentativas)

# Opcionais
# DB_POOL_MAX=10
# DB_STATEMENT_TIMEOUT_MS=15000
# LOG_LEVEL=info
