{
  "name": "nexo-people-backend",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "dev": "node --watch src/server.ts",
    "start": "node dist/server.js",
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint",
    "test": "node --test --test-concurrency=1 \"test/**/*.test.ts\"",
    "db:migrate": "node scripts/migrate.ts up",
    "db:migrate:down": "node scripts/migrate.ts down",
    "db:seed": "node src/db/seed.ts",
    "reconcile": "node src/reconcile.ts",
    "email:teste": "node scripts/email-teste.ts"
  },
  "dependencies": {
    "@fastify/cors": "^11.3.0",
    "@fastify/multipart": "^10.1.1",
    "fastify": "^5.12.5",
    "jose": "^6.2.12",
    "node-pg-migrate": "^9.0.0",
    "nodemailer": "^10.0.10",
    "pg": "^8.23.0"
  },
  "devDependencies": {
    "@types/node": "^24.13.3",
    "@types/pg": "^8.23.1",
    "oxlint": "^1.81.0",
    "typescript": "~6.0.2"
  }
}
