# Frontend (Vite) e Docker Compose. Copie para .env se precisar sobrescrever.
VITE_API_URL=http://localhost:3001/api/v1
# SSO Microsoft Entra: defina as três variáveis para habilitar o login corporativo.
# São identificadores públicos. Nunca coloque client secret em variáveis VITE_.
# VITE_MICROSOFT_TENANT_ID=00000000-0000-0000-0000-000000000000
# VITE_MICROSOFT_CLIENT_ID=00000000-0000-0000-0000-000000000000
# VITE_MICROSOFT_API_SCOPE=api://00000000-0000-0000-0000-000000000000/access_as_user
# Login por e-mail e senha (exige AUTH_EMAIL_SENHA=true no backend). Substitui o botão Microsoft neste build.
# VITE_AUTH_EMAIL_SENHA=true
# Porta do host para o PostgreSQL do Compose (mude se a 5432 já estiver ocupada).
DB_PORT=5432
